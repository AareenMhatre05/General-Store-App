# OS
.DS_Store
Thumbs.db
Desktop.ini

# Editors
.vscode/
.idea/
*.iml

# Each app/package under apps/ and packages/ has its own .gitignore
# for Flutter/Dart build artifacts; supabase/ has its own too.

# Release signing. A keystore in version control is a keystore anyone
# can ship updates with -- these must never be committed.
**/android/key.properties
*.jks
*.keystore


# Built APKs. Regenerated by `flutter build apk`; large binaries do not
# belong in git history.
dist/

# Gradle build output (the per-app android/.gitignore misses this one).
**/android/build/
**/android/.gradle/

# Installed Claude Code plugin, not project code. 10 MB of a third-party
# skill pack that has no business in this repository.
.claude/skills/
