<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon for Android 8+. The launcher masks this to whatever
     shape the device uses (circle, squircle, teardrop), so the mark sits
     well inside the guaranteed-visible centre of the foreground layer
     and the background is a flat colour rather than artwork. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
